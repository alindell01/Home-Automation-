# Copy this file to secrets.yaml and fill in real values.
# secrets.yaml is git-ignored — NEVER commit real secrets.
# Reference in YAML with: some_key: !secret my_secret_name

# --- Notifications --------------------------------------------------------
# Mobile app notify target (from the HA Companion app), e.g. notify.mobile_app_adam_iphone
mobile_notify_target: "notify.mobile_app_REPLACE_ME"

# Echo to use for spoken announcements (Alexa Media Player), e.g. media_player.kitchen_echo
alexa_announce_target: "media_player.REPLACE_ME"

# --- Camera / RTSP --------------------------------------------------------
reolink_username: "admin"
reolink_password: "REPLACE_ME"
reolink_host: "192.168.1.50"

# --- Cloud device accounts (only where the vendor forces cloud) -----------
blink_username: "REPLACE_ME@example.com"
blink_password: "REPLACE_ME"

dreame_username: "REPLACE_ME@example.com"
dreame_password: "REPLACE_ME"

# --- Dashboard (40" wall display) -----------------------------------------
# Long-Lived Access Token for the limited 'dashboard' user. See docs/dashboard-integration.md.
dashboard_token: "REPLACE_ME"

# --- Misc -----------------------------------------------------------------
latitude: 0.0
longitude: 0.0
elevation: 0
